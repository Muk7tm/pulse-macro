// Pulse design tokens: black and white. Neutral greys without tint, white
// as the only accent (with black on top of it), soft red for errors only,
// an 8 px spacing grid and uniform control heights.

export global Theme {
    // Colors
    out property <color> bg: #0A0A0A;
    out property <color> surface: #141414;
    out property <color> elevated: #1E1E1E;
    out property <color> elevated-hover: #2A2A2A;
    out property <color> border: #2C2C2C;
    out property <color> border-strong: #4A4A4A;
    out property <color> text: #FAFAFA;
    out property <color> text-secondary: #A3A3A3;
    out property <color> text-muted: #737373;
    out property <color> accent: #FAFAFA;
    out property <color> accent-hover: #D9D9D9;
    out property <color> accent-bright: #FFFFFF;
    // Text and knobs drawn on an accent background.
    out property <color> on-accent: #0A0A0A;
    // The Stop button: outlined in white rather than filled.
    out property <color> danger: #141414;
    out property <color> danger-hover: #2A2A2A;
    out property <color> error: #F87171;
    out property <color> warning: #E5E5E5;
    out property <color> success: #FAFAFA;
    out property <color> focus-ring: #FFFFFF;

    // Spacing, shape and sizes
    out property <length> gap-xs: 4px;
    out property <length> gap-s: 8px;
    out property <length> gap-m: 12px;
    out property <length> gap-l: 16px;
    out property <length> radius-s: 6px;
    out property <length> radius-m: 10px;
    out property <length> control-height: 32px;
    out property <length> label-width: 96px;
    out property <length> card-padding: 14px;

    // Typography
    out property <length> font-caption: 12px;
    out property <length> font-body: 13px;
    out property <length> font-strong: 14px;
    out property <length> font-title: 17px;

    // Transitions only, never continuous animation.
    out property <duration> quick: 120ms;
}
