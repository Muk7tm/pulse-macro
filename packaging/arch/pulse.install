post_install() {
    cat <<'MSG'
Pulse installed. Nothing was started or enabled.
  * Start the engine:  pulse-engine &   (or: systemctl --user enable --now pulse-engine)
  * Open the UI:       pulse-ui
  * uinput backend (optional): see /usr/share/doc/pulse/90-pulse-uinput.rules.example
Your configuration in ~/.config/pulse-macro is kept on upgrade and uninstall.
MSG
}

post_upgrade() {
    echo "Restart a running engine to use the new version: systemctl --user restart pulse-engine (or pulse-cli shutdown)"
}

pre_remove() {
    echo "Stop the engine before removal: pulse-cli shutdown; systemctl --user disable --now pulse-engine"
}
